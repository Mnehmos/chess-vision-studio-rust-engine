{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.selfplay"
  },
  "deploy": {
    "startCommand": "python3 /app/run_generation.py",
    "numReplicas": 4,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
