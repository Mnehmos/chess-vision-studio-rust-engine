{
  "funnelConfigVersion": 1,
  "prioritizerVersion": "priority-v1",
  "description": "Information-gain labeling funnel (#111). Tier 0 deterministic facts and Tier 1 shallow CVS search run on every sampled position; Tier 2 ranks them; Tier 3 deep CVS search and Tier 4 Stockfish run only on the selected subsets. Relative engine/data paths resolve against --artifact-root (default: repo root).",
  "seed": 111,
  "source": {
    "shards": ["training/gen10/corpus-d20/shards/*.jsonl"],
