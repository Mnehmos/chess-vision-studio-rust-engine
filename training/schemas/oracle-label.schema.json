{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chess-vision-studio/training/oracle-label.schema.json",
  "title": "Oracle label (v1)",
  "description": "INV-4 (issue #9): an independent oracle's label for a candidate seed. labeler.engineId MUST differ from the seed's finder.engineId — the engine that found a gap may not authoritatively label it. labelStatus carries the stabilization/quarantine verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "seedId", "labeler", "score", "labelStatus"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "seedId": { "type": "string", "minLength": 1, "description": "References candidate-seed.seedId." },
    "labeler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineId", "binarySha256", "version"],
      "properties": {
        "engineId": { "type": "string", "minLength": 1 },
        "binarySha256": { "type": "string" },
        "version": { "type": "string" },
        "options": { "type": "object" },
        "budget": { "type": "object" }
      }
    },
    "score": { "type": "object" },
    "pv": { "type": "array" },
    "stabilization": { "type": "object" },
    "labelStatus": { "enum": ["usable", "quarantined", "conflict"] }
  }
}
